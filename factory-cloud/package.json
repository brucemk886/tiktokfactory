{
  "name": "tiktokaitool-factory",
  "private": true,
  "type": "module",
  "scripts": {
    "cloudflare:check": "node scripts/check-origin-main.mjs",
    "deploy": "npm run cloudflare:check && wrangler d1 migrations apply factory-prod --remote --config wrangler.jsonc && wrangler deploy --config wrangler.jsonc",
    "d1:create": "wrangler d1 create factory-prod --config wrangler.jsonc",
    "test": "node --test src/jobs.test.js src/official-archive-store.test.js scripts/check-origin-main.test.js ../scripts/feishu-novel-import.test.js"
  },
  "devDependencies": {
    "wrangler": "^4.92.0"
  }
}
