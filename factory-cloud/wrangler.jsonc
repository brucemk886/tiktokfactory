{
  "name": "tiktok-factory",
  "main": "src/index.js",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "factory.tiktokaitool.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "../public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "factory-prod",
      "database_id": "3062c073-cae1-4b6e-8d68-b592187d7feb",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARCHIVE",
      "bucket_name": "factory-archive"
    }
  ],
  "triggers": {
    "crons": ["* * * * *", "0 0 * * *", "0 16 * * *"]
  },
  "vars": {
    "SIGNAL_DESK_BASE_URL": "https://tiktokaitool.com",
    "FEISHU_WIKI_URL": "https://my.feishu.cn/wiki/DMPvw98Wri5WCfk9wkScDrV1nce?sheet=acDhJT"
  }
}
